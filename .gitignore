# Real invoices carry PII: nothing under fixtures/invoices is committed
# except explicitly redacted text fixtures and the folder README.
fixtures/invoices/**
!fixtures/invoices/
!fixtures/invoices/*/
!fixtures/invoices/README.md
!fixtures/invoices/**/*.redacted.txt
!fixtures/invoices/**/*.expected.json

# Generated by XcodeGen from iosApp/project.yml
iosApp/iosApp.xcodeproj/
iosApp/iosApp/Info.plist
build-*.log
